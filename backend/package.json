{
  "name": "sharedrive-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env.local --import tsx --watch src/index.ts",
    "test": "tsx --test tests/validation.test.ts tests/runtime.test.ts tests/environmentSettings.test.ts tests/managedAssets.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "db:baseline": "tsx src/scripts/baseline.ts",
    "test:database": "tsx --test tests/database.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "archiver": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.2.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "nanoid": "^3.3.20",
    "nodemailer": "^10.0.15",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.6.13",
    "ua-parser-js": "^1.0.41",
    "zod": "^3.22.4",
    "prisma": "6.12.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.3",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
