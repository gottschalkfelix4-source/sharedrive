# ShareDrive: one HTTP application behind your existing reverse proxy.
# Run ./unraid/prepare-config.sh --compose before the first start to generate
# infrastructure credentials. The browser wizard configures the admin and app.

# Published HTTP port. Your reverse proxy manages HTTPS and certificates.
HTTP_PORT=8088
# Trust only your reverse proxy's IP/CIDR as seen by the app container.
# For example: TRUST_PROXY=192.168.188.10/32
TRUST_PROXY=loopback
#SMTP_ALLOWED_HOSTS=smtp.example.com

# PostgreSQL
POSTGRES_USER=sharedrive
POSTGRES_PASSWORD=change_me_db
POSTGRES_DB=sharedrive
DATABASE_URL=postgresql://sharedrive:change_me_db@postgres:5432/sharedrive

# MinIO object storage (private Docker network)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=sharedrive

# Redis
REDIS_URL=redis://redis:6379

# Virus scanning (ClamAV)
# Plaintext uploads are scanned before publishing; encrypted uploads cannot be scanned.
# Toggle on/off in Admin Settings / Security.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Generated during configuration preparation; never reuse the example value.
JWT_SECRET=change-me-to-a-long-random-secret-string

# Bootstrap token is generated into the private .setup/token file.
#SETUP_TOKEN_FILE=/app/.setup/token
